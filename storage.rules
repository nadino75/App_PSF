rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /usuarios/{uid}/{imageId} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.get('admin', false) == true);
      allow create: if resource == null && request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      // Immutable files: replacing an approved image requires a new review.
      allow update, delete: if false;
    }
  }
}
