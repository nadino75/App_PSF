rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===== FUNCIONES AUXILIARES =====
    function conectado() {
      return request.auth != null;
    }
    function miDocumento(uid) {
      return conectado() && request.auth.uid == uid;
    }
    function admin() {
      return conectado() && request.auth.token.get('admin', false) == true;
    }
    function dueno() {
      return conectado() && resource.data.duenoId == request.auth.uid;
    }
    function propietario(campo) {
      return conectado() && resource.data[campo] == request.auth.uid;
    }
    function duenoInmutable() {
      return request.resource.data.duenoId == resource.data.duenoId;
    }
    function autorInmutable() {
      return request.resource.data.autorId == resource.data.autorId;
    }
    function texto(v, minimo, maximo) {
      return v is string && v.size() >= minimo && v.size() <= maximo;
    }
    function validarCreacion(campos) {
      return request.resource.data.keys().hasAll(campos)
        && request.resource.data.creado == request.time
        && request.resource.data.actualizado == request.time;
    }

    // ===== USUARIOS =====
    match /usuarios/{uid} {
      allow create: if miDocumento(uid)
        && request.resource.data.keys().hasAll(['nombre', 'email', 'creado'])
        && request.resource.data.keys().hasOnly(['nombre', 'email', 'telefono', 'ciudad', 'pais', 'fotoPerfil', 'creado'])
        && texto(request.resource.data.nombre, 1, 100)
        && request.resource.data.email is string
        && request.resource.data.creado == request.time;

      allow read: if miDocumento(uid) || admin();

      allow update: if miDocumento(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'telefono', 'ciudad', 'pais', 'fotoPerfil'])
        && texto(request.resource.data.nombre, 1, 100);

      allow create: if admin()
        && request.resource.data.keys().hasOnly(['dueno'])
        && request.resource.data.dueno == true;

      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dueno'])
        && request.resource.data.dueno == true;

      allow delete: if false;

      match /solicitudes/{id} {
        allow read: if miDocumento(uid) || admin();
        allow create: if miDocumento(uid)
          && validarCreacion(['uid', 'tipo', 'negocioId', 'estado', 'propuesta', 'solicitanteId'])
          && request.resource.data.keys().hasOnly(['uid', 'tipo', 'negocioId', 'estado', 'propuesta', 'solicitanteId', 'creado', 'actualizado'])
          && request.resource.data.uid == uid
          && request.resource.data.solicitanteId == request.auth.uid
          && request.resource.data.tipo in ['negocio', 'cambio', 'anuncio']
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.propuesta is map;
        allow delete: if false;
      }

      match /favoritos/{id} {
        allow read: if miDocumento(uid);
        allow create: if miDocumento(uid)
          && request.resource.data.keys().hasOnly(['catalogoId', 'creado'])
          && request.resource.data.creado == request.time;
        allow delete: if miDocumento(uid);
      }

      match /lecturas/{id} {
        allow read: if miDocumento(uid);
        allow create: if miDocumento(uid)
          && request.resource.data.keys().hasOnly(['leida'])
          && request.resource.data.leida == true;
      }

      match /notificaciones/{id} {
        allow read: if miDocumento(uid);
        allow create: if admin();
        allow update: if miDocumento(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida'])
          && request.resource.data.leida is bool;
        allow delete: if false;
      }

      match /auditoria/{id} {
        allow read: if miDocumento(uid) || admin();
        allow write: if false;
        allow delete: if false;
      }
    }

    // ===== NEGOCIOS =====
    match /negocios/{id} {
      allow create: if conectado()
        && validarCreacion(['duenoId', 'nombre', 'descripcion', 'categoria', 'direccion', 'telefono', 'horarios', 'publicado', 'versionId'])
        && request.resource.data.keys().hasOnly(['duenoId', 'nombre', 'descripcion', 'categoria', 'direccion', 'telefono', 'horarios', 'publicado', 'versionId', 'creado', 'actualizado'])
        && request.resource.data.duenoId == request.auth.uid
        && texto(request.resource.data.nombre, 1, 150)
        && texto(request.resource.data.descripcion, 1, 1000)
        && texto(request.resource.data.categoria, 1, 100)
        && texto(request.resource.data.direccion, 1, 200)
        && texto(request.resource.data.telefono, 1, 20)
        && request.resource.data.publicado == false;

      allow read: if dueno() || admin() || (resource.data.publicado == true && conectado());

      allow update: if dueno() && duenoInmutable()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'descripcion', 'categoria', 'direccion', 'telefono', 'horarios', 'publicado', 'actualizado'])
        && texto(request.resource.data.nombre, 1, 150)
        && texto(request.resource.data.descripcion, 1, 1000)
        && texto(request.resource.data.categoria, 1, 100)
        && texto(request.resource.data.direccion, 1, 200)
        && texto(request.resource.data.telefono, 1, 20)
        && request.resource.data.actualizado == request.time;

      allow create, update: if admin();

      allow delete: if false;

      match /versiones/{version} {
        allow read: if dueno() || admin();
        allow create: if admin();
        allow update, delete: if false;
      }
    }

    // ===== CATÁLOGO =====
    match /catalogo/{id} {
      allow read: if resource.data.publicado == true || admin() || dueno();
      allow create, update: if admin();
      allow delete: if false;
    }

    // ===== ANUNCIOS =====
    match /anuncios/{id} {
      allow create: if conectado()
        && validarCreacion(['duenoId', 'negocioId', 'titulo', 'descripcion', 'precio', 'publicado'])
        && request.resource.data.keys().hasOnly(['duenoId', 'negocioId', 'titulo', 'descripcion', 'precio', 'imagen', 'publicado', 'creado', 'actualizado'])
        && request.resource.data.duenoId == request.auth.uid
        && texto(request.resource.data.titulo, 1, 200)
        && texto(request.resource.data.descripcion, 1, 1000)
        && request.resource.data.negocioId is string
        && request.resource.data.publicado == false;

      allow read: if resource.data.publicado == true || admin() || propietario('duenoId');

      allow update: if propietario('duenoId') && autorInmutable()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['titulo', 'descripcion', 'precio', 'imagen', 'publicado', 'actualizado'])
        && texto(request.resource.data.titulo, 1, 200)
        && texto(request.resource.data.descripcion, 1, 1000)
        && request.resource.data.actualizado == request.time;

      allow create, update: if admin();

      allow delete: if propietario('duenoId');
    }

    // ===== CATEGORÍAS =====
    match /categorias/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    // ===== BOLETINES =====
    match /boletines/{id} {
      allow read: if resource.data.publicado == true || admin();
      allow create, update: if admin();
      allow delete: if false;
    }

    // ===== NOVEDADES =====
    match /novedades/{id} {
      allow read: if conectado();
      allow create, update, delete: if admin();
    }

    // ===== SOLICITUDES (Global) =====
    match /solicitudes/{id} {
      allow read: if conectado() && (resource.data.solicitanteId == request.auth.uid || admin());
      allow create: if conectado()
        && validarCreacion(['solicitanteId', 'tipo', 'negocioId', 'estado', 'propuesta'])
        && request.resource.data.keys().hasOnly(['solicitanteId', 'tipo', 'negocioId', 'estado', 'propuesta', 'creado', 'actualizado'])
        && request.resource.data.solicitanteId == request.auth.uid
        && request.resource.data.tipo in ['negocio', 'cambio', 'anuncio']
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.propuesta is map
        && request.resource.data.negocioId is string;
      allow update: if admin()
        || (conectado()
          && resource.data.solicitanteId == request.auth.uid
          && resource.data.estado == 'pendiente'
          && request.resource.data.estado == 'retirada'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'actualizado']));
      allow delete: if false;
    }

    // ===== AUDITORIA =====
    match /auditoria/{id} {
      allow create: if conectado()
        && request.resource.data.keys().hasOnly(['userId', 'action', 'targetId', 'targetType', 'result', 'creado'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.creado == request.time;
      allow read: if admin() || (conectado() && resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    // ===== HISTORIAL =====
    match /historial/{id} {
      allow read: if conectado() && (resource.data.solicitanteId == request.auth.uid || admin());
      allow create: if admin();
      allow update, delete: if false;
    }

    // ===== DENY ALL =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
